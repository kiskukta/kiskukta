@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<IEnumerable<Kiskukta.Dnn.Dnn.Kiskukta.HelloWorld.Models.Item>>
@using DotNetNuke.Web.Mvc.Framework.ActionFilters
<div class="kiskukta-module">
    @foreach (var item in Model)
    {
        <div>
            <h3>@item.ItemName</h3>
            <p>@item.ItemDescription</p>
        </div>
    }
</div>