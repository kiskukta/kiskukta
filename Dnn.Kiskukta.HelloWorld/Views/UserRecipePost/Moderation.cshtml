@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<IEnumerable<Kiskukta.Dnn.Dnn.Kiskukta.HelloWorld.Models.UserRecipePostInfo>>

<div class="kiskukta-module">
    <h2>Moderáció</h2>

    @if (ViewBag.Message != null)
    {
        <div class="message-box">
            @ViewBag.Message
        </div>
    }

    @{
        bool hasPosts = false;
    }

    @if (Model != null)
    {
        foreach (var post in Model)
        {
            hasPosts = true;

            <div class="recipe-post moderation-post">
                <h3>@post.RecipeName</h3>

                <p><strong>ID:</strong> @post.PostId</p>
                <p><strong>Beküldő:</strong> @post.CreatedByDisplayName (@post.CreatedByUserId)</p>
                <p><strong>Dátum:</strong> @post.CreatedOnDate.ToString("yyyy.MM.dd. HH:mm")</p>

                <p>
                    <strong>Státusz:</strong>
                    <span>@post.StatusDisplay</span>
                </p>

                <p>@post.CommentText</p>

                @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                {
                    <img src="@post.ImagePath" class="recipe-image" />
                }

                <form action="@Url.Action("Approve", "UserRecipePost", new { ctl = "Approve" })"
                      method="post"
                      style="display:inline-block;">
                    <input type="hidden" name="postId" value="@post.PostId" />
                    <button type="submit">Elfogadás</button>
                </form>

                <form action="@Url.Action("Reject", "UserRecipePost", new { ctl = "Reject" })"
                      method="post"
                      style="display:inline-block;">
                    <input type="hidden" name="postId" value="@post.PostId" />
                    <button type="submit">Elutasítás</button>
                </form>

                <form action="@Url.Action("Delete", "UserRecipePost", new { ctl = "Delete" })"
                      method="post"
                      style="display:inline-block;"
                      onsubmit="return confirm('Biztosan törölni szeretnéd ezt a receptet?');">
                    <input type="hidden" name="postId" value="@post.PostId" />
                    <button type="submit">Törlés</button>
                </form>
            </div>
        }
    }

    @if (!hasPosts)
    {
        <p>Nincs moderálandó tartalom.</p>
    }
</div>