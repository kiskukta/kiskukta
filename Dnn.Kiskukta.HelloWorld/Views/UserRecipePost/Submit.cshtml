@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<Kiskukta.Dnn.Dnn.Kiskukta.HelloWorld.Models.UserRecipePostInfo>

<div class="kiskukta-module">
    <div class="kiskukta-header">
        <h2>Új recept beküldése</h2>
        <p class="kiskukta-subtitle">Töltsd fel a recept nevét, képet és a hozzászólásodat.</p>
    </div>

    <p>
        <a class="kiskukta-link" href="@Url.Action("Index", "UserRecipePost")">Vissza a listához</a>
    </p>

    @if (ViewBag.Message != null)
    {
        <div class="message-box">
            @ViewBag.Message
        </div>
    }

    <form class="kiskukta-form"
          action="@Url.Action("Submit", "UserRecipePost", new { ctl = "Submit" })"
          method="post"
          enctype="multipart/form-data">

        <input type="hidden" name="ModuleId" value="@Model.ModuleId" />

        <div class="form-group">
            <label>Recept neve</label>
            <input type="text" name="RecipeName" value="@Model.RecipeName" required />
        </div>

        <div class="form-group">
            <label>Komment</label>
            <textarea name="CommentText" required>@Model.CommentText</textarea>
        </div>

        <div class="form-group">
            <label>Kép feltöltése</label>
            <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" required />
            <small>Engedélyezett formátumok: JPG, JPEG, PNG, WEBP. Maximum méret: 5 MB.</small>
        </div>

        <button class="kiskukta-button" type="submit">Beküldés</button>
    </form>
</div>