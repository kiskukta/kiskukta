@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<IEnumerable<Kiskukta.Dnn.Dnn.Kiskukta.HelloWorld.Models.UserRecipePostInfo>>

<div class="kiskukta-module">
    <div class="kiskukta-header">
        <h2>Beküldött receptek</h2>
        <p class="kiskukta-subtitle">Közösségi receptötletek és vélemények</p>
    </div>

    @if (Request.IsAuthenticated)
    {
        <div class="kiskukta-action-row">
            <a class="kiskukta-button" href="@Url.Action("Submit", "UserRecipePost", new { ctl = "Submit" })">
                Új recept beküldése
            </a>
        </div>
    }
    else
    {
        <div class="message-box">
            Kérjük <a href="/Login">jelentkezz be</a> a recept beküldéséhez.
        </div>
    }

    @{
        bool hasPosts = false;
    }

    @if (Model != null)
    {
        foreach (var post in Model)
        {
            hasPosts = true;

            <div class="recipe-post">
                @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                {
                    <img src="@post.ImagePath" alt="@post.RecipeName" class="recipe-image" />
                }

                <div class="recipe-content">
                    <h3>@post.RecipeName</h3>

                    <p class="recipe-comment">@post.CommentText</p>

                    <div class="recipe-meta">
                        @if (!string.IsNullOrWhiteSpace(post.CreatedByDisplayName))
                        {
                            <span>Beküldő: @post.CreatedByDisplayName</span>
                        }

                        <span>Dátum: @post.CreatedOnDate.ToString("yyyy.MM.dd. HH:mm")</span>
                    </div>
                </div>
            </div>
        }
    }

    @if (!hasPosts)
    {
        <div class="empty-box">
            Még nincs jóváhagyott recept.
        </div>
    }
</div>