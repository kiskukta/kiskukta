<dotnetnuke type="Package" version="5.0">
  <packages>
    <package name="Dnn.Kiskukta.Module" type="Module" version="00.00.01">
      <friendlyName>Dnn.Kiskukta.Module</friendlyName>
      <description>Dnn.Kiskukta.Module</description>
      <iconFile>~/Icons/Sigma/Software_32X32_Standard.png</iconFile>
      <owner>
        <name>Kiskukta</name>
        <organization>Kiskukta</organization>
        <url>https://20.123.45.147/</url>
        <email>kiskuktaa20@gmail.com</email>
      </owner>
      <license src="License.txt"></license>
      <releaseNotes src="ReleaseNotes.txt"></releaseNotes>
      <dependencies>
        <dependency type="CoreVersion">09.08.00</dependency>
      </dependencies>
      <components>
        <component type="Script">
          <scripts>
            <basePath>DesktopModules\MVC\Dnn.Kiskukta.Module</basePath>
            <script type="Install">
              <path>Providers\DataProviders\SqlDataProvider</path>
              <name>00.00.01.SqlDataProvider</name>
              <version>00.00.01</version>
            </script>
            <script type="UnInstall">
              <path>Providers\DataProviders\SqlDataProvider</path>
              <name>Uninstall.SqlDataProvider</name>
              <version>00.00.01</version>
            </script>
          </scripts>
        </component>
        <component type="ResourceFile">
          <resourceFiles>
            <basePath>DesktopModules/MVC/Dnn.Kiskukta.Module</basePath>
            <resourceFile>
              <name>Resources.zip</name>
            </resourceFile>
          </resourceFiles>
        </component>
        <component type="Module">
          <desktopModule>
            <moduleName>Dnn.Kiskukta.Module</moduleName>
            <foldername>Dnn.Kiskukta.Module</foldername>
            <businessControllerClass>Dnn.Kiskukta.Dnn.Kiskukta.Module.Components.FeatureController</businessControllerClass>
            <supportedFeatures />
            <moduleDefinitions>
              <moduleDefinition>
                <friendlyName>Dnn.Kiskukta.Module</friendlyName>
                <defaultCacheTime>0</defaultCacheTime>
                <moduleControls>
					
					<!-- FŐ NÉZET -->
					<moduleControl>
						<controlKey />
						<controlSrc>Dnn.Kiskukta.Dnn.Kiskukta.Module.Controllers/UserRecipePost/Index.mvc</controlSrc>
						<supportsPartialRendering>False</supportsPartialRendering>
						<controlTitle />
						<controlType>View</controlType>
						<iconFile />
						<helpUrl />
						<viewOrder>0</viewOrder>
					</moduleControl>

					<!-- BEKÜLDÉS -->
					<moduleControl>
						<controlKey>Submit</controlKey>
						<controlSrc>Dnn.Kiskukta.Dnn.Kiskukta.Module.Controllers/UserRecipePost/Submit.mvc</controlSrc>
						<supportsPartialRendering>False</supportsPartialRendering>
						<controlTitle>Recept beküldése</controlTitle>
						<controlType>View</controlType>
						<iconFile />
						<helpUrl />
						<viewOrder>1</viewOrder>
					</moduleControl>

					<!-- MODERÁCIÓ -->
					<moduleControl>
						<controlKey>Moderation</controlKey>
						<controlSrc>Dnn.Kiskukta.Dnn.Kiskukta.Module.Controllers/UserRecipePost/Moderation.mvc</controlSrc>
						<supportsPartialRendering>False</supportsPartialRendering>
						<controlTitle>Moderáció</controlTitle>
						<controlType>View</controlType>
						<iconFile />
						<helpUrl />
						<viewOrder>2</viewOrder>
					</moduleControl>

				</moduleControls>
              </moduleDefinition>
            </moduleDefinitions>
          </desktopModule>
        </component>
        <component type="Assembly">
          <assemblies>
            <assembly>
              <name>Dnn.Kiskukta.Module.dll</name>
              <path>bin</path>
            </assembly>
          </assemblies>
        </component>
      </components>
    </package>
  </packages>
