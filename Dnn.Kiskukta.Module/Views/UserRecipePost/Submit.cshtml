@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<Dnn.Kiskukta.Dnn.Kiskukta.Module.Models.UserRecipePostInfo>

<link rel="stylesheet" href="/DesktopModules/MVC/Dnn.Kiskukta.Module/module.css?v=19" />

<div class="kiskukta-module">
    <div class="kiskukta-header">
        <h1>Új recept beküldése</h1>
        <h3>Oszd meg velünk, mit készítettél!</h3>
    </div>

    <p class="submit-back-row">
        <a class="kiskukta-link" href="@Url.Action("Index", "UserRecipePost")">
            Vissza a közösségi kedvencekhez
        </a>
    </p>

    @if (ViewBag.Message != null)
    {
        <div class="message-box">
            @ViewBag.Message
        </div>
    }

    <div class="submit-card">
        <form class="kiskukta-form"
              action="@Url.Action("Submit", "UserRecipePost", new { ctl = "Submit" })"
              method="post"
              enctype="multipart/form-data">

            <input type="hidden" name="ModuleId" value="@Model.ModuleId" />

            <div class="form-group">
                <label>Kategória</label>

                <select name="Category" class="category-select" required>
                    <option value="">-- Válassz kategóriát --</option>
                    <option value="Leves" @(Model.Category == "Leves" ? "selected" : "")>Leves</option>
                    <option value="Főétel" @(Model.Category == "Főétel" ? "selected" : "")>Főétel</option>
                    <option value="Köret" @(Model.Category == "Köret" ? "selected" : "")>Köret</option>
                    <option value="Saláta" @(Model.Category == "Saláta" ? "selected" : "")>Saláta</option>
                    <option value="Desszert" @(Model.Category == "Desszert" ? "selected" : "")>Desszert</option>
                    <option value="Reggeli" @(Model.Category == "Reggeli" ? "selected" : "")>Reggeli</option>
                    <option value="Snack" @(Model.Category == "Snack" ? "selected" : "")>Snack</option>
                    <option value="Tészta" @(Model.Category == "Tészta" ? "selected" : "")>Tészta</option>
                    <option value="Vegetáriánus" @(Model.Category == "Vegetáriánus" ? "selected" : "")>Vegetáriánus</option>
                    <option value="Vegán" @(Model.Category == "Vegán" ? "selected" : "")>Vegán</option>
                    <option value="Sütemény" @(Model.Category == "Sütemény" ? "selected" : "")>Sütemény</option>
                    <option value="Egyéb" @(Model.Category == "Egyéb" ? "selected" : "")>Egyéb</option>
                </select>
            </div>

            <div class="form-group">
                <label>Recept neve</label>
                <input type="text" name="RecipeName" value="@Model.RecipeName" required />
            </div>

            <div class="form-group">
                <label>Megjegyzés</label>
                <textarea name="CommentText" required>@Model.CommentText</textarea>
            </div>

            <div class="form-group">
                <label>Kép feltöltése</label>
                <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" required />
                <small>JPG, JPEG, PNG vagy WEBP formátum. Maximum 5 MB.</small>
            </div>

            <button class="kiskukta-button submit-button" type="submit">
                Beküldés
            </button>
        </form>
    </div>
</div>
