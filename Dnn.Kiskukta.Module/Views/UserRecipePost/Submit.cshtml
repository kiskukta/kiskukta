@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<Dnn.Kiskukta.Dnn.Kiskukta.Module.Models.UserRecipePostInfo>

<link rel="stylesheet" href="/DesktopModules/MVC/Dnn.Kiskukta.Module/module.css?v=9" />

<div class="kiskukta-module">
    <div class="kiskukta-header">
        <h1>Új recept beküldése</h1>
        <h3>Oszd meg velünk, mit készítettél!</h3>
    </div>

    <p class="submit-back-row">
        <a class="kiskukta-link" href="@Url.Action("Index", "UserRecipePost")">
            Vissza a közösségi kedvencekhez
        </a>
    </p>

    @if (ViewBag.Message != null)
    {
        <div class="message-box">
            @ViewBag.Message
        </div>
    }

    <div class="submit-card">
        <form class="kiskukta-form"
              action="@Url.Action("Submit", "UserRecipePost", new { ctl = "Submit" })"
              method="post"
              enctype="multipart/form-data">

            <input type="hidden" name="ModuleId" value="@Model.ModuleId" />

            <div class="form-group">
                <label>Kategória</label>

                <div class="category-options">
                    <label>
                        <input type="radio" name="Category" value="Leves" required />
                        <span>Leves</span>
                    </label>

                    <label>
                        <input type="radio" name="Category" value="Főétel" />
                        <span>Főétel</span>
                    </label>

                    <label>
                        <input type="radio" name="Category" value="Desszert" />
                        <span>Desszert</span>
                    </label>

                    <label>
                        <input type="radio" name="Category" value="Saláta" />
                        <span>Saláta</span>
                    </label>

                    <label>
                        <input type="radio" name="Category" value="Tészta" />
                        <span>Tészta</span>
                    </label>

                    <label>
                        <input type="radio" name="Category" value="Vegetáriánus" />
                        <span>Vegetáriánus</span>
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label>Recept neve</label>
                <input type="text" name="RecipeName" value="@Model.RecipeName" required />
            </div>

            <div class="form-group">
                <label>Megjegyzés</label>
                <textarea name="CommentText" required>@Model.CommentText</textarea>
            </div>

            <div class="form-group">
                <label>Kép feltöltése</label>
                <input type="file" name="imageFile" accept=".jpg,.jpeg,.png,.webp" required />
                <small>JPG, JPEG, PNG vagy WEBP formátum. Maximum 5 MB.</small>
            </div>

            <button class="kiskukta-button submit-button" type="submit">
                Beküldés
            </button>
        </form>
    </div>
</div>