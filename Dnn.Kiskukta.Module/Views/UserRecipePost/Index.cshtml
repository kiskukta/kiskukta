@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<IEnumerable<Dnn.Kiskukta.Dnn.Kiskukta.Module.Models.UserRecipePostInfo>>

<link rel="stylesheet" href="/DesktopModules/MVC/Dnn.Kiskukta.Module/module.css" />

<div class="kiskukta-module">
    <div class="kiskukta-header">
        <h1>Közösségi Kedvenceink</h1>
        <h3>Nézd meg, mit főztek a többiek!</h3>
    </div>

    @if (Request.IsAuthenticated)
    {
        <p>
            <a class="kiskukta-link" href="@Url.Action("Submit", "UserRecipePost", new { ctl = "Submit" })">
                Új recept beküldése
            </a>
        </p>
    }
    else
    {
        <div class="message-box">
            Szólj hozzá te is! A kommenteléshez bejelentkezés szükséges.
        </div>
    }

    @{
        bool hasPosts = false;
    }

    @if (Model != null)
    {
        <div class="recipe-list">

            @foreach (var post in Model)
            {
                hasPosts = true;

                <div class="recipe-card">

                    @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                    {
                        <img class="recipe-image" src="@post.ImagePath" alt="@post.RecipeName" />
                    }

                    <div class="recipe-body">
                        <div class="recipe-title">
                            @post.RecipeName
                        </div>

                        <div class="recipe-meta-row">
                            <span class="recipe-user">@post.CreatedByDisplayName</span>
                            <span class="recipe-date">@post.CreatedOnDate.ToString("yyyy.MM.dd.")</span>
                        </div>

                        <div class="recipe-comment">
                            @post.CommentText
                        </div>
                    </div>

                </div>
            }

        </div>
    }

    @if (!hasPosts)
    {
        <div class="empty-box">
            Még nem érkezett vélemény. Légy te az első!
        </div>
    }
</div>
