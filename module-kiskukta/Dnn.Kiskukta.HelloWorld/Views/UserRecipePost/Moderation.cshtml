@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<IEnumerable<Kiskukta.Dnn.Dnn.Kiskukta.HelloWorld.Models.UserRecipePostInfo>>

<div class="kiskukta-module">
    <h2>Moderáció</h2>

    <p>
        <a href="@Url.Action("Index")">Vissza a listához</a>
    </p>

    @if (ViewBag.Message != null)
    {
        <div style="margin-bottom:15px; padding:10px; border:1px solid #ccc;">
            @ViewBag.Message
        </div>
    }

    @if (Model == null)
    {
        <p>Nincs moderálandó tartalom.</p>
    }
    else
    {
        var hasPosts = false;

        foreach (var post in Model)
        {
            hasPosts = true;

            <div style="border:1px solid #ccc; margin-bottom:10px; padding:10px;">
                <h3>@post.RecipeName</h3>

                <p><strong>ID:</strong> @post.PostId</p>
                <p><strong>Beküldő azonosító:</strong> @post.CreatedByUserId</p>
                <p><strong>Státusz:</strong> @post.Status</p>
                <p>@post.CommentText</p>

                @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                {
                    <p>
                        <img src="@post.ImagePath" style="max-width:300px;" />
                    </p>
                }

                <form action="@Url.Action("Approve")" method="post" style="display:inline-block;">
                    <input type="hidden" name="postId" value="@post.PostId" />
                    <button type="submit">Jóváhagyás</button>
                </form>

                <form action="@Url.Action("Reject")" method="post" style="display:inline-block;">
                    <input type="hidden" name="postId" value="@post.PostId" />
                    <button type="submit">Elutasítás</button>
                </form>

                <form action="@Url.Action("Delete")" method="post" style="display:inline-block;">
                    <input type="hidden" name="postId" value="@post.PostId" />
                    <button type="submit" onclick="return confirm('Biztosan törölni szeretnéd?');">
                        Törlés
                    </button>
                </form>
            </div>
        }

        if (!hasPosts)
        {
            <p>Nincs moderálandó tartalom.</p>
        }
    }
</div>