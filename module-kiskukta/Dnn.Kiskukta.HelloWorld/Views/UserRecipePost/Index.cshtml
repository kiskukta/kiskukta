@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<IEnumerable<Kiskukta.Dnn.Dnn.Kiskukta.HelloWorld.Models.UserRecipePostInfo>>

<div class="kiskukta-module">
    <h2>Beküldött receptek</h2>

    @if (Request.IsAuthenticated)
    {
        <p>
            <a href="@Url.Action("Submit")">Új recept beküldése</a>
        </p>

        <p>
            <a href="@Url.Action("Moderation")">Moderációs nézet</a>
        </p>
    }
    else
    {
        <p>Kérjük <a href="/Login">jelentkezz be a recept beküldéséhez.</a></p>
    }

    @if (Model == null)
    {
        <p>Még nincs jóváhagyott recept.</p>
    }
    else
    {
        var hasPosts = false;

        foreach (var post in Model)
        {
            hasPosts = true;

            <div style="border:1px solid #ddd; padding:15px; margin-bottom:15px;">
                <h3>@post.RecipeName</h3>

                @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                {
                    <img src="@post.ImagePath" style="max-width:300px;" />
                }

                <p>@post.CommentText</p>
                <p><strong>Dátum:</strong> @post.CreatedOnDate</p>
            </div>
        }

        if (!hasPosts)
        {
            <p>Még nincs jóváhagyott recept.</p>
        }
    }
</div>